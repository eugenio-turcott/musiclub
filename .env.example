# =========================================================================
# MUSICLUB - VARIABLES DE ENTORNO
# =========================================================================

# Supabase
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key
REACT_APP_SUPABASE_SERVICE_KEY=your_service_key

# Spotify Web API
REACT_APP_SPOTIFY_CLIENT_ID=your_spotify_client_id
REACT_APP_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# =========================================================================
# SERVICIO DE CORREOS ELECTRÓNICOS (Notificaciones de Estrenos)
# =========================================================================
# Opción 1: Gmail (Recomendado para pruebas o producción pequeña con Contraseña de Aplicación)
# GMAIL_USER=tu_correo@gmail.com
# GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres

# Opción 2: Servidor SMTP estándar (Brevo, SendGrid, Mailgun, Amazon SES, etc.)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=tu_usuario_smtp
# SMTP_PASS=tu_clave_smtp
# EMAIL_FROM="Musiclub Estrenos" <notificaciones@musiclub.org>

# * Si no se define ninguna variable de correo, el sistema usa automáticamente
#   Ethereal Email generando un enlace web instantáneo para previsualizar los correos.
