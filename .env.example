# Public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-key

# Server only: never use NEXT_PUBLIC for private credentials
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-new-client-secret
SUPABASE_SERVICE_ROLE_KEY=your-new-service-role-key
ADMIN_EMAILS=your-admin-email
CRON_SECRET=your-long-random-cron-secret
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-new-smtp-password
EMAIL_FROM=your-sender-address
