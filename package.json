    "pretest:browser": "node scripts/build-genre-assets.mjs",
    "cloudflare:build": "node scripts/build-genre-assets.mjs && node scripts/build-cloudflare.mjs",
    "cloudflare:preview": "opennextjs-cloudflare preview --port 3103",
    "cloudflare:deploy": "node scripts/deploy-cloudflare.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sitemap": "node scripts/generate-sitemap.js",
    "ingest:mb": "node scripts/hourlyMusicBrainzIngestion.mjs",
    "ingest:daemon": "node scripts/runHourlyDaemon.mjs",
    "enrich:missing": "node scripts/enrichMissingMusicBrainz.mjs",
    "seed": "node scripts/smartCatalogSeeder.mjs",
    "sync:recordclub": "node scripts/sync-record-club-supabase.mjs",
    "sync:recordclub:daily": "node scripts/dailyRecordClubSync.mjs",
    "sync:recordclub:force": "node scripts/dailyRecordClubSync.mjs --force",
    "check:releases": "node scripts/checkUpcomingReleasesCron.mjs",
    "send:patchnotes": "node scripts/sendPatchNotesEmail.mjs",
    "test:critical": "node --test tests/critical.test.mjs tests/pool-graduation.test.mjs tests/operations.test.mjs tests/genres.test.mjs tests/genre-recommendations.test.mjs tests/pool-manual.test.mjs tests/pool-capsules.test.mjs tests/cover-ratings.test.mjs tests/musicbrainz-identity.test.mjs tests/private-backup.test.mjs tests/artist-discographies.test.mjs tests/catalog-spotify-search.test.mjs tests/review-chronology.test.mjs tests/pool-nomination-schema.test.mjs tests/pool-release-genres.test.mjs tests/pool-rooms.test.mjs tests/pool-review-schedule.test.mjs tests/catalog-performance.test.mjs tests/cover-image-source.test.mjs tests/release-library.test.mjs tests/visual-interface.test.mjs tests/release-refresh.test.mjs",
    "genres:update": "node scripts/update-genre-registry.mjs",
    "test:browser": "playwright test",
    "tracks:audit": "node scripts/audit-release-tracks.mjs",
    "genres:audit": "node scripts/audit-release-genres.mjs",
    "backup:seal": "node scripts/seal-private-backup.mjs",
    "backup:verify": "node scripts/verify-private-recovery.mjs"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@opennextjs/cloudflare": "^1.20.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.156.0"
  }
}
