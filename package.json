{
  "name": "musiclub",
  "version": "10.2.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "dotenv": "^18.0.8",
    "html2canvas": "^1.4.1",
    "next": "^16.4.2",
    "nodemailer": "^10.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "sharp": "0.35.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "prebuild": "node scripts/build-genre-assets.mjs",
    "predev": "node scripts/build-genre-assets.mjs",
